# Deployed setup and normal local setup: the backend in apps/api.
# Every /api/... call is forwarded there. No trailing slash.
# Netlify: set this as an environment variable. Locally: API_URL=http://localhost:4000 npm run dev
API_URL=http://localhost:4000

# Quick local alternative without the backend: leave API_URL empty and the app's own
# /api/chat route calls the n8n webhook directly.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/advisor-chat
# Optional: sent to n8n in the X-Internal-Key header
N8N_WEBHOOK_SECRET=
