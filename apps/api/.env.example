# Port the server listens on. Render sets this itself; locally it defaults to 4000.
PORT=4000

# Production URL of the Advisor chat webhook in n8n (the Webhook node shows it once the workflow is Active)
N8N_CHAT_URL=http://localhost:5678/webhook/advisor-chat

# Secret shared with n8n, sent in the X-Internal-Key header. The Webhook node in n8n uses
# Header Auth with the same value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# Optional
RATE_LIMIT_PER_MINUTE=30
# This backend's own address as n8n can reach it (no trailing slash). Needed for two things: n8n posts finished long
# answers back to it, and n8n calls the agent's search tools on it. Locally, with n8n on the same machine:
# PUBLIC_API_URL=http://localhost:4000
# On Render this is set by Render itself (RENDER_EXTERNAL_URL), so it can stay empty there.
AGENT_TIMEOUT_MS=600000
# How many times the agent may use its search tools for one question (needs PUBLIC_API_URL and DATABASE_URL)
# AGENT_MAX_TOOL_CALLS=6

# Knowledge base (PostgreSQL, see packages/db). Without it the agent answers from general knowledge.
# Use the same value as in packages/db/.env; a password with special characters must be percent-encoded.
DATABASE_URL=

# Optional: lets a small model (Haiku) turn each question into search keywords (translates Dutch,
# expands abbreviations, adds synonyms) before the knowledge base is searched. Needs DATABASE_URL.
ANTHROPIC_API_KEY=
# REWRITE_MODEL=claude-haiku-4-5-20251001

# Memory (chats kept on the server, lessons confirmed by a reviewer). Needs DATABASE_URL and the schema
# packages/db/schema/003_memory.sql (npm run db:init in packages/knowledge).
# Key a reviewer types on the web app page /review. Without it the review page is switched off.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REVIEW_API_KEY=
# Optional: the choices of the two dropdowns above the chat (comma separated). Customers can also be typed freely.
# MEMORY_CUSTOMERS=Customer A,Customer B
# The IFS versions loaded in the knowledge base. Saved answers and notes are kept apart per version.
MEMORY_VERSIONS=IFS Apps 10,IFS Cloud 25R2
# Websites that may call this backend directly from the browser (comma separated, no trailing slash).
# Needed when the website host cuts long requests, as Netlify does: set NEXT_PUBLIC_CHAT_API_URL on the website too.
# CORS_ORIGINS=https://12guide-assistant-test.netlify.app

# Optional: token counts of every answer, read from the stored n8n execution after the answer was sent (logged as event "usage").
# Needs an n8n API key whose scope is only execution:read (n8n: Settings > n8n API). Without both values nothing is read.
# N8N_API_URL=http://localhost:5678
# N8N_API_KEY=

# Quick reports, Option A (create the report in IFS through its web UI with Playwright). Off unless IFS_AUTOMATION=on: set it only on the computer that
# runs the automation, never on the hosted backend. IFS_STORAGE_STATE is a Playwright session file that you save yourself after signing in to IFS;
# no user name or password is ever stored or typed by the backend. It stays out of Git.
# IFS_AUTOMATION=off
# IFS_BASE_URL=https://your-environment.build.ifs.cloud/landing-page/
# IFS_STORAGE_STATE=C:/path/outside/the/repo/ifs-session.json

# Read-only inspection of the IFS screens (npm run ifs:inspect): where the recordings go. Outside the repository.
# IFS_INSPECTION_DIR=C:/path/outside/the/repo/ifs-inspection
# IFS_REHEARSAL=on
# Option A first fills in the New Report dialog and cancels it (a rehearsal: nothing is saved). Only IFS_REHEARSAL=off creates reports.
# IFS_HEADED=on
# With IFS_HEADED=on a real run of Option A (rehearsal off) is done in a visible browser too, so that the first one can be watched.
# IFS_TEST_EXECUTE=on
# A test run of a report that exists in IFS first only rehearses (opens the report, fills in the parameters, does not press Execute). Only IFS_TEST_EXECUTE=on runs the SQL in IFS.
